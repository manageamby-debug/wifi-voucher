# Copy this file to .env and fill in your real values. Never commit .env.

PORT=4001
CORS_ORIGINS=http://localhost:4001,http://127.0.0.1:4001
JWT_SECRET=change-me-to-something-long-and-random

# ── ClickPesa (mobile money — M-Pesa, Tigo Pesa/Mixx, Airtel Money, HaloPesa) ──
# Get these from the ClickPesa Merchant Dashboard (https://merchant.clickpesa.com)
# → Settings → Developers → your application.
CLICKPESA_BASE_URL=https://api.clickpesa.com/third-parties
CLICKPESA_CLIENT_ID= IDWBlcdI8UE8ikfdGzehanDYsxhdA4uq
CLICKPESA_API_KEY=SKdEW2aYweM9AB0cFE2ayDevSIQ2rwpnUSp9ZhmtWO

# Optional: only set this if you've enabled request/webhook checksums on your
# ClickPesa application (Settings → Developers → your application → Checksum).
# Leave blank to skip checksum verification.
CLICKPESA_CHECKSUM_KEY=
